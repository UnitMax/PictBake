{
  "manifest_version": 3,
  "name": "PictBake",
  "description": "Offline image converter for saving WebP and other browser-supported images as PNG or JPEG.",
  "version": "0.1.0",
  "permissions": [
    "contextMenus",
    "downloads",
    "storage",
    "offscreen"
  ],
  "optional_host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "PictBake"
  },
  "options_page": "options.html",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self';"
  }
}
